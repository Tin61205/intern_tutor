# .env.example
# Đổi tên file này thành .env và điền thông tin thật của bạn vào
APP_NAME="TaskHub API"
API_PREFIX="/api/v1"

# Thay thế bằng user, pass, host, port và tên database thật
DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/db_name"

# JWT Settings (Sinh chuỗi ngẫu nhiên bằng lệnh: openssl rand -hex 32)
SECRET_KEY="super-secret-key-for-local-dev-only"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis Settings
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD="Nhap-mat-khau-vao-day"
